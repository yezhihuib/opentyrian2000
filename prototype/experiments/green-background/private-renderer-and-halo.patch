+/* Only the HD green trail samples a continuous value for unreplaced indexed
+ * scenery. Keep the authored hue/coverage and original value-average operator.
+ * Existing HD pixels retain their exact value; a HD/outside neighbor tap uses
+ * the current indexed value instead of smearing a different HD object. */
+static unsigned int green_trail_background_peak(int x,int y,Uint32 dst)
+{
+ int d=game_probe_density,den=2*d;
+ int qx=2*(x%d)+1-d,qy=2*(y%d)+1-d;
+ int bx=x/d,by=y/d,wx=qx,wy=qy;
+ if(qx<0){--bx;wx+=den;}if(qy<0){--by;wy+=den;}
+ unsigned int current=MAX((dst>>16)&255,MAX((dst>>8)&255,dst&255));
+ unsigned int sum=0;
+ for(int iy=0;iy<2;iy++)for(int ix=0;ix<2;ix++) {
+  int tx=(bx+ix)*d+d/2,ty=(by+iy)*d+d/2;
+  unsigned int peak=current;
+  if(tx>=0&&ty>=0&&tx<canvas->w&&ty<canvas->h&&hd_owner[ty*canvas->w+tx]==0) {
+   Uint32 color=*((Uint32 *)((Uint8 *)canvas->pixels+ty*canvas->pitch)+tx);
+   peak=MAX((color>>16)&255,MAX((color>>8)&255,color&255));
+  }
+  sum+=peak*(unsigned int)(ix?wx:den-wx)*(unsigned int)(iy?wy:den-wy);
+ }
+ return (sum+(unsigned int)(den*den/2))/(unsigned int)(den*den);
+}
